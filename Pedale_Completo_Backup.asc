TEXT -960 40 Left 2 !.subckt OPAMP_TL074LIKE inp inm vp vm out\nBgain gopen 0 V=0.5*(V(vp)+V(vm)) + (0.5*(V(vp)-V(vm))-1.5)*tanh(100k*V(inp,inm)/(0.5*(V(vp)-V(vm))-1.5))\nRpole gopen pole1 1k\nCpole pole1 0 5n\nEout out 0 pole1 0 1\nRout out 0 10\n.ends OPAMP_TL074LIKE\n \n.subckt OTA_LM13700 inp inm iabc outp vm vp\nRvp_dummy vp vm 1Meg\nDiabc1 iabc iabcmid D1N4148\nDiabc2 iabcmid vm D1N4148\nRind inp inm 700\nBout outp vm I=I(Diabc1)*tanh(V(inp,inm)/0.052)\n.ends OTA_LM13700\n \n.model D1N4148 D(Is=2.52n Rs=0.568 N=1.752 Cjo=4p M=0.4 tt=20n)\n.model DZ4V7 D(Is=1p Rs=3 N=1 BV=4.7 IBV=1m Cjo=80p M=0.3 Vj=0.75)\n.model Q2N3904M NPN(IS=6.734E-15 BF=416.4 NF=1.259 VAF=74.03 IKF=66.78E-3 ISE=6.734E-15 NE=1.259 BR=.7371 NR=1 RB=10 RC=1 XTB=1.5 XTI=3 EG=1.11 CJE=4.493E-12 VJE=.75 MJE=.2593 TF=301.2E-12 XTF=2 VTF=4 ITF=.4 CJC=3.638E-12 VJC=.75 MJC=.3085 FC=.5 TR=239.5E-9)
